# Copy to .env for local development: `cp .env.example .env`
# Every value here is a local-only placeholder. Real values live in Fly secrets
# (production) and your password manager. Never commit .env.

DJANGO_SECRET_KEY=local-dev-only-not-a-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Postgres from docker-compose (production: Neon, direct connection string)
DATABASE_URL=postgres://tickets:tickets@db:5432/tickets

# S3-compatible storage from docker-compose (production: Cloudflare R2)
S3_ENDPOINT_URL=http://storage:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=ticket-tracker-local
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path

LOG_LEVEL=INFO

# AI form assistant. With no key it answers from the field's help text (production: the key
# is a Fly secret, the other two are in fly.toml)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Reviewer logins created by `manage.py seed_users`: a Lead and an Agent for each of the
# two reviewers, each with its own password (local placeholders; production: Fly secrets)
DEMO_LEAD_1_PASSWORD=local-lead-1-demo-only
DEMO_AGENT_1_PASSWORD=local-agent-1-demo-only
DEMO_LEAD_2_PASSWORD=local-lead-2-demo-only
DEMO_AGENT_2_PASSWORD=local-agent-2-demo-only
