# Copy to .env for local development: `cp .env.example .env`
# Every value here is a local-only placeholder. Real values live in Fly secrets
# (production) and your password manager. Never commit .env.

DJANGO_SECRET_KEY=local-dev-only-not-a-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Postgres from docker-compose (production: Neon, direct connection string)
DATABASE_URL=postgres://tickets:tickets@db:5432/tickets

# S3-compatible storage from docker-compose (production: Cloudflare R2)
S3_ENDPOINT_URL=http://storage:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=ticket-tracker-local
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path

LOG_LEVEL=INFO
